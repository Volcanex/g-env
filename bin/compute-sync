#!/usr/bin/env python3
"""compute-sync: pull h's compute pace and mode overrides onto this host.

Hosts without the session collector have no active hours of their own, and the overrides
the operator sets on gcommand's /compute page live on h. Every 15 minutes
this fetches gcommand's /api/compute/sync (G_COMPUTE_SYNC_URL, else the
gcommand domain in the instance manifest) with the read-only bearer token in
~/.config/genv/compute-token (0600) and writes ~/.cache/genv/compute-pace.json
and compute-mode.json atomically, so temperature.py reads the same state here
as on h. A failed fetch leaves the old files; they age into "stale" on their own.
Exit 0 on success, 1 on any failure (printed to stderr).
"""
import json
import os
import sys
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'context'))
from instance import service_url  # noqa: E402


def sync_url():
    if os.environ.get('G_COMPUTE_SYNC_URL'):
        return os.environ['G_COMPUTE_SYNC_URL']
    base = service_url('gcommand')
    if base is None:
        raise RuntimeError('G_COMPUTE_SYNC_URL is unset and the instance manifest names no gcommand domain')
    return base + '/api/compute/sync'


def write(path, data):
    tmp = path.with_suffix('.tmp')
    tmp.write_text(json.dumps(data, indent=1) + '\n')
    os.replace(tmp, path)


def main():
    home = Path(os.environ.get('HOME', '~')).expanduser()
    token = (home / '.config/genv/compute-token').read_text().strip()
    req = urllib.request.Request(sync_url(), headers={'Authorization': f'Bearer {token}'})
    with urllib.request.urlopen(req, timeout=30) as res:
        data = json.load(res)
    cache = home / '.cache/genv'
    cache.mkdir(parents=True, exist_ok=True)
    if data.get('pace'):
        write(cache / 'compute-pace.json', data['pace'])
    mode = cache / 'compute-mode.json'
    if data.get('mode') is not None:
        write(mode, data['mode'])
    elif mode.exists():
        mode.unlink()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as exc:
        print(f'compute-sync: {type(exc).__name__}: {exc}', file=sys.stderr)
        sys.exit(1)
