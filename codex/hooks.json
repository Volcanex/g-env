{
  "description": "G-System live root instructions and Brain session orientation",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/session-context.py\" --hook",
            "timeout": 25,
            "statusMessage": "Loading G-System context",
            "additionalContextLimit": 12000
          }
        ]
      }
    ]
  }
}
